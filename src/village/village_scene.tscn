[gd_scene format=3]

[ext_resource type="Script" path="res://src/village/village_scene.gd" id="1_village"]
[ext_resource type="Script" path="res://src/village/camera_rig.gd" id="2_camera"]
[ext_resource type="PackedScene" path="res://src/train/train.tscn" id="3_train"]
[ext_resource type="Script" path="res://src/village/day_clock.gd" id="4_clock"]
[ext_resource type="Script" path="res://src/villagers/villager_routines.gd" id="5_routines"]
[ext_resource type="Script" path="res://src/villagers/kid_tag.gd" id="6_kids"]
[ext_resource type="Script" path="res://src/villagers/rooftop_dash.gd" id="7_dash"]
[ext_resource type="Script" path="res://src/village/village_log.gd" id="8_log"]
[ext_resource type="Script" path="res://src/events/event_director.gd" id="9_events"]
[ext_resource type="Script" path="res://src/village/daylight.gd" id="10_daylight"]
[ext_resource type="Script" path="res://src/village/night_glow.gd" id="11_glow"]
[ext_resource type="Script" path="res://src/village/simulation_speed.gd" id="12_speed"]
[ext_resource type="PackedScene" path="res://src/ui/hud.tscn" id="13_hud"]
[ext_resource type="PackedScene" path="res://src/ui/title_screen.tscn" id="14_title"]

[node name="VillageScene" type="Node2D"]
script = ExtResource("1_village")

[node name="Ground" type="Node2D" parent="."]

[node name="World" type="Node2D" parent="."]
y_sort_enabled = true

[node name="CameraRig" type="Camera2D" parent="."]
script = ExtResource("2_camera")

[node name="Train" parent="." node_paths=PackedStringArray("village") instance=ExtResource("3_train")]
village = NodePath("..")

[node name="DayClock" type="Node" parent="."]
script = ExtResource("4_clock")

[node name="VillagerRoutines" type="Node" parent="." node_paths=PackedStringArray("village", "clock", "train")]
script = ExtResource("5_routines")
village = NodePath("..")
clock = NodePath("../DayClock")
train = NodePath("../Train")

[node name="KidTag" type="Node" parent="." node_paths=PackedStringArray("village", "clock", "routines")]
script = ExtResource("6_kids")
village = NodePath("..")
clock = NodePath("../DayClock")
routines = NodePath("../VillagerRoutines")

[node name="RooftopDash" type="Node" parent="." node_paths=PackedStringArray("village", "routines")]
script = ExtResource("7_dash")
village = NodePath("..")
routines = NodePath("../VillagerRoutines")

[node name="VillageLog" type="Node" parent="." node_paths=PackedStringArray("clock", "routines", "kid_tag", "rooftop_dash")]
script = ExtResource("8_log")
clock = NodePath("../DayClock")
routines = NodePath("../VillagerRoutines")
kid_tag = NodePath("../KidTag")
rooftop_dash = NodePath("../RooftopDash")

[node name="EventDirector" type="Node" parent="." node_paths=PackedStringArray("village", "clock", "routines", "village_log")]
script = ExtResource("9_events")
village = NodePath("..")
clock = NodePath("../DayClock")
routines = NodePath("../VillagerRoutines")
village_log = NodePath("../VillageLog")

[node name="NightTint" type="CanvasModulate" parent="."]

[node name="Daylight" type="Node" parent="." node_paths=PackedStringArray("village", "clock", "train", "tint")]
script = ExtResource("10_daylight")
village = NodePath("..")
clock = NodePath("../DayClock")
train = NodePath("../Train")
tint = NodePath("../NightTint")

[node name="NightGlow" type="CanvasLayer" parent="." node_paths=PackedStringArray("village", "train", "daylight")]
layer = 1
follow_viewport_enabled = true
script = ExtResource("11_glow")
village = NodePath("..")
train = NodePath("../Train")
daylight = NodePath("../Daylight")

[node name="SimulationSpeed" type="Node" parent="." node_paths=PackedStringArray("clock", "village_log", "title")]
script = ExtResource("12_speed")
clock = NodePath("../DayClock")
village_log = NodePath("../VillageLog")
title = NodePath("../TitleScreen")

[node name="Hud" parent="." node_paths=PackedStringArray("village", "sim", "clock", "village_log", "train", "routines", "kid_tag") instance=ExtResource("13_hud")]
village = NodePath("..")
sim = NodePath("../SimulationSpeed")
clock = NodePath("../DayClock")
village_log = NodePath("../VillageLog")
train = NodePath("../Train")
routines = NodePath("../VillagerRoutines")
kid_tag = NodePath("../KidTag")

[node name="TitleScreen" parent="." instance=ExtResource("14_title")]
